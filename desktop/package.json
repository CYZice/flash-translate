{
  "name": "flash-translate-desktop",
  "version": "0.1.4",
  "private": true,
  "description": "Lightweight global selection companion for Flash Translate",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:windows": "electron .",
    "start:linux": "electron --ozone-platform-hint=auto .",
    "dev": "electron .",
    "test": "node --test src/*.test.cjs",
    "test:ui": "electron scripts/check-result-ui.cjs",
    "portable:windows": "node scripts/build-portable.cjs windows",
    "portable:linux": "node scripts/build-portable.cjs linux",
    "package:deb": "python3 scripts/build-deb.py"
  },
  "dependencies": {
    "selection-hook": "^2.1.2"
  },
  "devDependencies": {
    "electron": "^38.2.0"
  }
}
