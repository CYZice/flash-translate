#!/bin/sh
# Exit on any error
set -e

# Check if there are any staged files
if [ -z "$(git diff --cached --name-only)" ]; then
  echo "No staged files to format"
  exit 0
fi

# Refuse partial staging because formatting the working copy would otherwise
# mix unstaged edits into the commit.
for file in $(git diff --cached --name-only --diff-filter=ACMR); do
  if ! git diff --quiet -- "$file"; then
    echo "Partially staged files cannot be formatted safely: $file"
    exit 1
  fi
done

# Store the hash of staged changes to detect formatter modifications.
STAGED_HASH=$(git diff --cached | sha256sum | cut -d' ' -f1)

# Format only staged files, then stage the formatter output.
git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 bun x ultracite fix --
git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 git add --

# Check if staged files actually changed
NEW_STAGED_HASH=$(git diff --cached | sha256sum | cut -d' ' -f1)
if [ "$STAGED_HASH" != "$NEW_STAGED_HASH" ]; then
  echo "✨ Files formatted by Ultracite"
fi
